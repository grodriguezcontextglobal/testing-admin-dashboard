# Dev server for the Admin Console access check (console plan F9):
#   npm run dev:platform-e2e   (port 5523)
#   npm run test:platform
#
# Committed on purpose: it holds no secret. The API host does not exist; the
# spec (cypress/e2e/platform) answers every call to it, so the check never
# reaches a real server. Values here override .env, so a local .env with real
# hosts and a real Stripe key is not used.
VITE_APP_DEVITRACK_API=https://api.platform-e2e.invalid/api
VITE_APP_DEVITRACK_API_BACKUP=
VITE_APP_PUBLIC_STRIPE_KEY=pk_test_platform_e2e
# The console on, and the sample data OFF. This check is about who may enter,
# and the demo mode (PLATFORM_CONSOLE_MOCK) opens the console to everyone
# without asking the server, which would make every assertion below pass for
# the wrong reason.
VITE_APP_FEATURE_PLATFORM_CONSOLE=true
VITE_APP_PLATFORM_CONSOLE_MOCK=false
# Production's defaults (release.yml), so the screens around the console are
# the ones production ships.
VITE_APP_FEATURE_SCOPED_ROLES=true
VITE_APP_FEATURE_MEMBER_FEES=true
VITE_APP_FEATURE_INVENTORY_SERVER_PAGINATION=true
VITE_APP_FEATURE_EVENT_INVITATIONS=false
