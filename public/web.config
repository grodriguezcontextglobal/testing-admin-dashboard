<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Security headers (FedRAMP A2), written here by vite.config.js at build
         time: see src/config/securityHeaders.js. -->
    <!-- SECURITY_HEADERS -->

    <!-- One build, two hosts. admin.devitrak.net serves the customer
         dashboard; ops.devitrak.net serves the Admin Console at /platform
         (DESIGN_platform_console.md section 4, option B). Same files, two IIS
         sites pointing at the same junction, so there is one artifact to
         deploy and one to roll back.

         A different host is a different browser origin, which is the point:
         the console's session, localStorage and service worker are not the
         customer app's, so a bug in one cannot read the other's storage. It
         also gives the console a site that can be stopped, IP-restricted or
         have its certificate revoked on its own.

         These two rules must stay ABOVE the React Router rule below, which
         matches ".*" with stopProcessing="true". src/config/webConfigHosts.test.js
         fails if they are moved after it or edited away. -->
    <rewrite>
      <rules>
        <!-- The console is reachable on its host and nowhere else. A bookmark
             of admin.devitrak.net/platform follows the move instead of
             breaking. 302, not 301: a permanent redirect would be cached in
             the operators' browsers and could not be taken back. -->
        <rule name="Console host only" stopProcessing="true">
          <match url="^platform(/.*)?$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^ops\.devitrak\.net(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://ops.devitrak.net/{R:0}" redirectType="Found" appendQueryString="true" />
        </rule>

        <!-- Typing the host is enough; it opens on the console. Only the root
             is redirected, because the sign-in flow and its assets are served
             from this origin too.

             The URL carries its scheme instead of being relative: measured on
             production the day this shipped, a relative url="/platform" made
             IIS answer an https request with Location: http://ops.devitrak.net
             /platform. Nothing was exposed (a 301 http->https runs in front and
             HSTS is a year), but the first visit from a browser with no HSTS
             entry took one cleartext hop for no reason. -->
        <rule name="Console host root" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^ops\.devitrak\.net(:\d+)?$" />
          </conditions>
          <action type="Redirect" url="https://ops.devitrak.net/platform" redirectType="Found" />
        </rule>

        <!-- Rewrite non-file/dir requests to index.html -->
        <rule name="React Router" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: Prevent IIS dynamic compression on JS/JSON -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="application/javascript" enabled="false" />
        <add mimeType="application/json" enabled="false" />
        <add mimeType="text/*" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- Optional: Map missing MIME types -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

  </system.webServer>

  <!--
    POA&M DVK-ADMIN-2026-001, M4 and the outage of 2026-11-23.

    version.json is served from here as a plain static file, with no location
    block of any kind, and that is deliberate.

    Two attempts were made to serve it uncached. The first, a Cache-Control
    custom header scoped with a location element, deployed and served fine but the
    header never appeared in the response. The second put a staticContent section
    with clientCache cacheControlMode="DisableCache" inside that same location;
    it also failed to produce the header, and about twenty minutes later every
    request to both sites answered 500 -- static files included, which is the
    signature of an IIS configuration error rather than an application fault.
    staticContent is commonly locked at machine level, and a worker process
    that already held the previous configuration would not fail until it
    recycled, which matches the delay.

    So: no location element here. The uncached header is tracked in the POA&M as risk
    accepted with a compensating control, and the next step is a question to
    whoever administers the reverse proxy rather than a third attempt. It is
    not worth another outage: deploy-check.yml appends a cache-busting
    parameter and sends its own no-cache request header, so the monitor this
    whole item exists to make work is unaffected either way.
  -->
</configuration>
