# Build for the E2E CSP check (GovRAMP #9, SC-18): npm run build:csp-check.
# Committed on purpose: it holds no secret. The API host does not exist; the
# spec (cypress/e2e/csp) answers every call to it, so the check never reaches
# a real server and the policy names this host in connect-src.
# Values here override .env, so a local .env with real hosts is not used.
VITE_APP_DEVITRACK_API=https://api.csp-check.invalid/api
VITE_APP_DEVITRACK_API_BACKUP=
VITE_APP_DEVITRAK_CONSUMER_API=https://consumer.csp-check.invalid/api
VITE_APP_PUBLIC_STRIPE_KEY=pk_test_csp_check
# Blank, so a local .env never puts its tokens into this build.
VITE_APP_TWILIO_ACCOUNT_SID=
VITE_APP_TWILIO_AUTH_TOKEN=
VITE_APP_AWS_AUTHORIZER_TOKEN=
# Production's defaults (release.yml), so the check builds the screens
# production ships. Subscription plans on too, to cover its Stripe checkout.
VITE_APP_FEATURE_SCOPED_ROLES=true
VITE_APP_FEATURE_MEMBER_FEES=true
VITE_APP_FEATURE_INVENTORY_SERVER_PAGINATION=true
VITE_APP_FEATURE_EVENT_INVITATIONS=false
VITE_APP_FEATURE_SUBSCRIPTION_PLANS=true
